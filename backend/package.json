{
  "name": "patholy-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:local": "nodemon --signal SIGTERM --ignore .mongo-data scripts/dev-local.js",
    "seed": "node scripts/seed.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "create-admin": "node scripts/create-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jose": "^6.2.18",
    "mongoose": "^8.8.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.4.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.3.2"
  }
}
