# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5001

# MongoDB (Atlas or local). Not needed for `npm run dev:local`.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sanjibani?retryWrites=true&w=majority

# At least 32 random characters in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend URLs
CLIENT_ORIGINS=http://localhost:5173

# Email notifications (Gmail: use an App Password, not your normal password)
EMAIL_ENABLED=false
EMAIL=you@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Razorpay online payments (leave unset / "your…" to disable; patients can still pay at collection)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Lab report storage: local (default) or s3 (AWS S3 / Cloudflare R2 / DigitalOcean Spaces)
STORAGE_DRIVER=local
UPLOAD_DIR=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
