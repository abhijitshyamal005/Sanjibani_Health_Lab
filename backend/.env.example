# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5001

# MongoDB (Atlas or local). Not needed for `npm run dev:local`.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sanjibani?retryWrites=true&w=majority

# At least 32 random characters in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed frontend URLs
CLIENT_ORIGINS=http://localhost:5173

# Public website URL — used for links in emails (defaults to the first CLIENT_ORIGINS entry)
APP_URL=http://localhost:5173

# Shown in every email footer / used as reply-to
COMPANY_NAME=SanjiBani Health
SUPPORT_EMAIL=care@yourdomain
LABS_EMAIL=labs@yourdomain
PAYMENTS_EMAIL=payments@yourdomain
SUPPORT_PHONE=

# Email notifications. In production use an HTTPS email API — Render's free tier blocks SMTP ports.
EMAIL_ENABLED=false
# Brevo (free 300/day): API key from app.brevo.com → SMTP & API → API keys; EMAIL_FROM must be a verified sender
BREVO_API_KEY=
EMAIL_FROM=
# Local fallback: Gmail SMTP with an App Password (not your normal password)
EMAIL=you@gmail.com
EMAIL_PASSWORD=your-16-char-app-password

# Free UPI payments — platform UPI ID used when a lab hasn't added its own (QR + transaction ID, confirmed by you/the lab)
UPI_ID=
UPI_NAME=SanjiBani Health

# Lab report storage: local (default) or s3 (AWS S3 / Cloudflare R2 / DigitalOcean Spaces)
STORAGE_DRIVER=local
UPLOAD_DIR=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
